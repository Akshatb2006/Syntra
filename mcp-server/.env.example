# --- Server ---
PORT=3100
LOG_DIR=./logs
NODE_ENV=development

# --- Auth ---
# Comma-separated list of "token:username" pairs. Each token grants access
# to the MCP server. Distribute one token per teammate.
VALID_TOKENS=tok_local:local-dev

# --- Workspaces ---
# Root directory where per-run repos are cloned. Created on demand.
WORKSPACE_ROOT=./workspaces

# --- Claude Code ---
# Path to the claude binary (leave as "claude" if on PATH).
CLAUDE_BIN=claude
# Subprocess soft-timeout for a single dispatch (ms).
DISPATCH_TIMEOUT_MS=900000

# --- Webhook secrets ---
# GitHub: shared secret configured on the webhook in repo settings.
GITHUB_WEBHOOK_SECRET=changeme-github
# Vercel: signing secret from Vercel integration.
VERCEL_WEBHOOK_SECRET=changeme-vercel

# --- Optional: Default GitHub auth for plugins (otherwise per-run token) ---
GITHUB_TOKEN=

# --- Optional: Tunnel URL the dashboard will hit (for logging only) ---
PUBLIC_BASE_URL=
