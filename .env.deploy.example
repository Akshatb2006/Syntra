# Compose-level variables (read by docker-compose.yml). Copy to ./.env:
#   cp .env.deploy.example .env
#
# The public domain that points at this VM's IP. Caddy gets HTTPS for it and
# it MUST equal the host in dashboard/.env's AUTH_URL (https://$DOMAIN).
# Free option: a DuckDNS subdomain (e.g. syntra-alpha.duckdns.org).
DOMAIN=app.yourdomain.com
