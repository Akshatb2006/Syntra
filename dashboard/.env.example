# --- MCP Server (the tunnel URL your friend's laptop points at) ---
MCP_BASE_URL=http://localhost:3100
MCP_BEARER_TOKEN=tok_local

# --- LLM ---
ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-opus-4-7
WORKER_MODEL=claude-sonnet-4-6

# --- Web search (Tavily preferred; falls back to stub) ---
TAVILY_API_KEY=

# --- Local SQLite (state) ---
SQLITE_PATH=./data/growth-engineer.db

# --- Omium tracing (optional bonus) ---
# If both are set, the OmiumTracer ships spans to Omium.
OMIUM_API_URL=
OMIUM_API_KEY=
OMIUM_PROJECT_ID=growth-engineer

# --- Encryption for stored secrets at rest ---
# 32-byte key, hex encoded. Generate: openssl rand -hex 32
SECRETS_ENC_KEY=
